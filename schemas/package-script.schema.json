{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/package-script.schema.json",
  "title": "AgentShell Package Script Response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocolVersion", "compact", "packageManager", "package", "script", "summary", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.package-script.v1" },
        "compact": { "type": "boolean" },
        "packageManager": { "enum": ["npm", "pnpm", "yarn", "bun"] },
        "package": { "$ref": "#/$defs/package" },
        "script": { "$ref": "#/$defs/script" },
        "summary": { "$ref": "#/$defs/summary" },
        "suggestedNextActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    { "$ref": "common.schema.json#/$defs/failure" }
  ],
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "private", "path"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "private": { "type": "boolean" },
        "path": { "type": "string" }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "category", "risky", "longRunning"],
      "properties": {
        "name": { "type": "string" },
        "command": { "type": "string" },
        "category": { "enum": ["test", "build", "lint", "typecheck", "dev", "format", "other"] },
        "risky": { "type": "boolean" },
        "longRunning": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalScripts", "scriptFound", "category", "risky", "longRunning"],
      "properties": {
        "totalScripts": { "type": "integer", "minimum": 0 },
        "scriptFound": { "const": true },
        "category": { "enum": ["test", "build", "lint", "typecheck", "dev", "format", "other"] },
        "risky": { "type": "boolean" },
        "longRunning": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "reason"],
      "properties": {
        "command": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
