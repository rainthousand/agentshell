{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/grep.schema.json",
  "title": "AgentShell Grep Response",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "query", "summary", "files", "results", "truncated", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.grep.v1" },
        "compact": { "type": "boolean" },
        "query": { "type": "string" },
        "summary": {
          "type": "object",
          "required": ["fileCount", "totalMatches", "returnedMatches", "omittedMatches", "ignoredDirs", "limits", "engine"],
          "properties": {
            "fileCount": { "type": "integer", "minimum": 0 },
            "totalMatches": { "type": "integer", "minimum": 0 },
            "returnedMatches": { "type": "integer", "minimum": 0 },
            "omittedMatches": { "type": "integer", "minimum": 0 },
            "ignoredDirs": {
              "type": "array",
              "items": { "type": "string" }
            },
            "limits": {
              "type": "object",
              "required": ["maxMatches", "maxMatchesPerFile", "contextChars"],
              "properties": {
                "maxMatches": { "type": "integer", "minimum": 1 },
                "maxMatchesPerFile": { "type": "integer", "minimum": 1 },
                "contextChars": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            },
            "engine": { "enum": ["rg", "node-fallback"] }
          },
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "matches", "returned", "omitted", "truncated"],
            "properties": {
              "file": { "type": "string" },
              "matches": { "type": "integer", "minimum": 0 },
              "returned": { "type": "integer", "minimum": 0 },
              "omitted": { "type": "integer", "minimum": 0 },
              "truncated": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "line", "column", "text", "context"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 },
              "text": { "type": "string" },
              "context": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "truncated": {
          "type": "object",
          "required": ["value", "omittedMatches", "reason"],
          "properties": {
            "value": { "type": "boolean" },
            "omittedMatches": { "type": "integer", "minimum": 0 },
            "reason": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "suggestedNextActions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/suggestedNextAction" }
        }
      },
      "additionalProperties": false
    },
    { "$ref": "common.schema.json#/$defs/failure" }
  ]
}
