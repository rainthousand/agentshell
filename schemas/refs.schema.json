{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/refs.schema.json",
  "title": "AgentShell Refs Response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocolVersion", "compact", "query", "summary", "matches", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.refs.v1" },
        "compact": { "type": "boolean" },
        "query": { "type": "string" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileCount", "totalMatches", "returnedMatches", "omittedMatches", "truncated", "ignoredDirs", "limit", "engine"],
          "properties": {
            "fileCount": { "type": "integer", "minimum": 0 },
            "totalMatches": { "type": "integer", "minimum": 0 },
            "returnedMatches": { "type": "integer", "minimum": 0 },
            "omittedMatches": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "ignoredDirs": {
              "type": "array",
              "items": { "type": "string" }
            },
            "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
            "engine": { "enum": ["rg", "node-fallback"] }
          }
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "lineNumbers", "count", "preview"],
            "properties": {
              "file": { "type": "string" },
              "lineNumbers": {
                "type": "array",
                "items": { "type": "integer", "minimum": 1 }
              },
              "count": { "type": "integer", "minimum": 1 },
              "preview": { "type": "string", "maxLength": 120 }
            }
          }
        },
        "suggestedNextActions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/suggestedNextAction" }
        }
      }
    },
    { "$ref": "common.schema.json#/$defs/failure" }
  ]
}
