{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/test-list.schema.json",
  "title": "AgentShell Test List Response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocolVersion", "compact", "summary", "scripts", "files", "packages", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.test-list.v1" },
        "compact": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/summary" },
        "scripts": {
          "type": "array",
          "items": { "$ref": "#/$defs/script" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" }
        },
        "packages": {
          "type": "array",
          "items": { "$ref": "#/$defs/package" }
        },
        "suggestedNextActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    { "$ref": "common.schema.json#/$defs/failure" }
  ],
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalScripts", "totalFiles", "returnedFiles", "truncated", "packageCount", "nodePackageCount", "goPackageCount", "goWorkspaceCount", "nodeFileCount", "goFileCount", "hasTests"],
      "properties": {
        "totalScripts": { "type": "integer", "minimum": 0 },
        "totalFiles": { "type": "integer", "minimum": 0 },
        "returnedFiles": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "packageCount": { "type": "integer", "minimum": 0 },
        "nodePackageCount": { "type": "integer", "minimum": 0 },
        "goPackageCount": { "type": "integer", "minimum": 0 },
        "goWorkspaceCount": { "type": "integer", "minimum": 0 },
        "nodeFileCount": { "type": "integer", "minimum": 0 },
        "goFileCount": { "type": "integer", "minimum": 0 },
        "hasTests": { "type": "boolean" }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "category", "packageManager", "runCommand"],
      "properties": {
        "name": { "type": "string" },
        "command": { "type": "string" },
        "category": { "enum": ["test", "spec", "e2e", "unit"] },
        "packageManager": { "enum": ["npm", "pnpm", "yarn", "bun"] },
        "runCommand": { "type": "string" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "language", "kind"],
      "properties": {
        "path": { "type": "string" },
        "language": { "enum": ["javascript", "typescript", "go"] },
        "kind": { "enum": ["node-pattern", "node-directory", "go-test"] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "path"],
      "properties": {
        "type": { "enum": ["node", "go", "go-workspace"] },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "packageManager": { "enum": ["npm", "pnpm", "yarn", "bun"] },
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "node" } } },
          "then": { "required": ["packageManager"] }
        },
        {
          "if": { "properties": { "type": { "const": "go-workspace" } } },
          "then": { "required": ["modules"] }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "reason"],
      "properties": {
        "command": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
