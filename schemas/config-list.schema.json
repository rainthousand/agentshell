{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/config-list.schema.json",
  "title": "AgentShell Config List Response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocolVersion", "compact", "summary", "configs", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.config-list.v1" },
        "compact": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/summary" },
        "configs": {
          "type": "array",
          "items": { "$ref": "#/$defs/config" }
        },
        "suggestedNextActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    { "$ref": "common.schema.json#/$defs/failure" }
  ],
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalConfigs", "returnedConfigs", "truncated", "categories", "risks", "hasNode", "hasGo", "hasPython", "hasJava", "hasCi", "hasContainers", "hasAgentConfig"],
      "properties": {
        "totalConfigs": { "type": "integer", "minimum": 0 },
        "returnedConfigs": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "categories": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "risks": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "hasNode": { "type": "boolean" },
        "hasGo": { "type": "boolean" },
        "hasPython": { "type": "boolean" },
        "hasJava": { "type": "boolean" },
        "hasCi": { "type": "boolean" },
        "hasContainers": { "type": "boolean" },
        "hasAgentConfig": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "category", "risk", "readCommand"],
      "properties": {
        "path": { "type": "string" },
        "type": {
          "enum": [
            "package-json",
            "tsconfig",
            "jsconfig",
            "vite",
            "webpack",
            "rollup",
            "eslint",
            "prettier",
            "biome",
            "go-mod",
            "go-work",
            "pyproject",
            "requirements",
            "setup-py",
            "setup-cfg",
            "tox",
            "pytest",
            "poetry-lock",
            "pipfile",
            "maven",
            "gradle-build",
            "gradle-settings",
            "gradle-properties",
            "build-wrapper",
            "makefile",
            "dockerfile",
            "compose",
            "github-actions",
            "ci",
            "agent-config"
          ]
        },
        "category": {
          "enum": ["package", "language", "build", "quality", "go", "python", "java", "automation", "container", "ci", "agent"]
        },
        "risk": { "enum": ["low", "medium", "high"] },
        "readCommand": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "reason"],
      "properties": {
        "command": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
