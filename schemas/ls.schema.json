{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/ls.schema.json",
  "title": "AgentShell List Directory Response",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "path", "summary", "entries", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.ls.v1" },
        "compact": { "type": "boolean" },
        "path": { "type": "string" },
        "summary": {
          "type": "object",
          "required": ["totalEntries", "returnedEntries", "truncated", "files", "directories", "symlinks", "hidden", "important", "manifests", "tests", "generated"],
          "properties": {
            "totalEntries": { "type": "integer", "minimum": 0 },
            "returnedEntries": { "type": "integer", "minimum": 0, "maximum": 500 },
            "truncated": { "type": "boolean" },
            "files": { "type": "integer", "minimum": 0 },
            "directories": { "type": "integer", "minimum": 0 },
            "symlinks": { "type": "integer", "minimum": 0 },
            "hidden": { "type": "integer", "minimum": 0 },
            "important": { "type": "integer", "minimum": 0 },
            "manifests": { "type": "array", "items": { "type": "string" } },
            "tests": { "type": "array", "items": { "type": "string" } },
            "generated": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "entries": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/entry" } },
        "suggestedNextActions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      },
      "additionalProperties": false
    },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["name", "kind", "sizeBytes", "hidden", "important", "manifest", "test", "generated"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["file", "directory", "symlink", "other"] },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "hidden": { "type": "boolean" },
        "important": { "type": "boolean" },
        "manifest": { "type": "boolean" },
        "test": { "type": "boolean" },
        "generated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": { "command": { "type": "string" }, "reason": { "type": "string" } },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["ok", "error"],
      "properties": { "ok": { "const": false }, "error": { "type": "object" } },
      "additionalProperties": false
    }
  }
}
