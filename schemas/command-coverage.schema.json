{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.dev/schemas/command-coverage.schema.json",
  "title": "AgentShell Command Coverage",
  "oneOf": [
    { "$ref": "#/$defs/report" },
    { "$ref": "#/$defs/observationResult" },
    { "$ref": "#/$defs/ingestResult" },
    { "$ref": "#/$defs/resetResult" }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "status", "totals", "rates", "telemetry", "opportunities", "privacy", "summary"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.command-coverage.v1" },
        "compact": { "type": "boolean" },
        "status": { "enum": ["available", "partial"] },
        "totals": { "$ref": "#/$defs/totals" },
        "rates": {
          "type": "object",
          "required": ["commandCoveragePercent", "fallbackRatePercent", "replacementOpportunityPercent"],
          "properties": {
            "commandCoveragePercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "fallbackRatePercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "replacementOpportunityPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "required": ["agentShellEventsAvailable", "externalCommandTelemetryAvailable", "externalObservationCount", "dedupeMethod", "scope"],
          "properties": {
            "agentShellEventsAvailable": { "const": true },
            "externalCommandTelemetryAvailable": { "type": "boolean" },
            "externalObservationCount": { "type": "integer", "minimum": 0 },
            "dedupeMethod": { "const": "source-event-id-sha256" },
            "scope": { "enum": ["observed-local-tool-calls", "agentshell-events-only"] }
          },
          "additionalProperties": false
        },
        "opportunities": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["executable", "category", "count", "replacement"],
            "properties": {
              "executable": { "type": "string" },
              "category": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 },
              "replacement": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "privacy": { "$ref": "#/$defs/privacy" },
        "summary": { "type": "object" },
        "suggestedNextActions": { "type": "array" }
      },
      "additionalProperties": false
    },
    "ingestResult": {
      "type": "object",
      "required": ["ok", "protocolVersion", "source", "received", "recorded", "duplicates", "totals", "rates", "privacy", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.command-coverage.v1" },
        "source": { "type": "string" },
        "received": { "type": "integer", "minimum": 1 },
        "recorded": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 },
        "totals": { "$ref": "#/$defs/totals" },
        "rates": { "$ref": "#/$defs/rates" },
        "privacy": { "$ref": "#/$defs/privacy" },
        "suggestedNextActions": { "type": "array" }
      },
      "additionalProperties": false
    },
    "observationResult": {
      "type": "object",
      "required": ["ok", "protocolVersion", "recorded", "duplicate", "privacy", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.command-coverage.v1" },
        "recorded": { "$ref": "#/$defs/observation" },
        "duplicate": { "type": "boolean" },
        "privacy": { "$ref": "#/$defs/privacy" },
        "suggestedNextActions": { "type": "array" }
      },
      "additionalProperties": false
    },
    "resetResult": {
      "type": "object",
      "required": ["ok", "protocolVersion", "removedObservations", "preservedAgentShellEvents"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.command-coverage.v1" },
        "removedObservations": { "type": "integer", "minimum": 0 },
        "preservedAgentShellEvents": { "const": true }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["id", "createdAt", "source", "executable", "category", "supportedReplacement", "replacement"],
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "executable": { "type": "string" },
        "category": { "type": "string" },
        "supportedReplacement": { "type": "boolean" },
        "replacement": { "type": ["string", "null"] },
        "eventFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "adapterIngestPayload": {
      "type": "object",
      "required": ["protocolVersion", "source", "observations"],
      "properties": {
        "protocolVersion": { "const": "agentshell.adapter-command-observation.v1" },
        "source": { "type": "string", "minLength": 1, "maxLength": 32 },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["eventId"],
            "properties": {
              "eventId": { "type": "string", "minLength": 1, "maxLength": 256 },
              "executableFamily": { "type": "string", "minLength": 1 },
              "operation": { "type": "string" },
              "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            },
            "anyOf": [
              { "required": ["executableFamily"] },
              { "required": ["argv"] }
            ]
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": ["localOnly", "storesArguments", "storesPaths", "storesOutput", "storesExecutableFamily", "storesEventIds", "storesEventFingerprints"],
      "properties": {
        "localOnly": { "const": true },
        "storesArguments": { "const": false },
        "storesPaths": { "const": false },
        "storesOutput": { "const": false },
        "storesExecutableFamily": { "const": true },
        "storesEventIds": { "const": false },
        "storesEventFingerprints": { "const": true }
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": ["observedCommands", "agentShellHits", "externalCommands", "eligibleFallbacks", "unsupportedExternalCommands"],
      "properties": {
        "observedCommands": { "type": "integer", "minimum": 0 },
        "agentShellHits": { "type": "integer", "minimum": 0 },
        "externalCommands": { "type": ["integer", "null"], "minimum": 0 },
        "eligibleFallbacks": { "type": ["integer", "null"], "minimum": 0 },
        "unsupportedExternalCommands": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "rates": {
      "type": "object",
      "required": ["commandCoveragePercent", "fallbackRatePercent", "replacementOpportunityPercent"],
      "properties": {
        "commandCoveragePercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "fallbackRatePercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "replacementOpportunityPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    }
  }
}
