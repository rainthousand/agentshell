{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/changed-impact.schema.json",
  "title": "AgentShell Changed Impact Response",
  "type": "object",
  "required": ["ok", "protocolVersion", "compact", "summary", "impacts", "files", "recommendedCommands", "risks", "suggestedNextActions"],
  "properties": {
    "ok": { "const": true },
    "protocolVersion": { "const": "agentshell.changed-impact.v1" },
    "compact": { "type": "boolean" },
    "summary": { "type": "object" },
    "impacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/impact" }
    },
    "files": { "type": "array" },
    "recommendedCommands": { "type": "array" },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "suggestedNextActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "impact": {
      "type": "object",
      "required": ["area", "confidence", "reason"],
      "properties": {
        "area": { "type": "string" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["type", "severity", "message"],
      "properties": {
        "type": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high"] },
        "message": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": {
        "command": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
