{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.dev/schemas/log-delta.schema.json",
  "title": "AgentShell Incremental Log Delta Response",
  "oneOf": [
    { "$ref": "#/$defs/readResult" },
    { "$ref": "#/$defs/resetResult" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "readResult": {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "action", "source", "cursor", "summary", "errors", "statusChanges", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.log-delta.v1" },
        "compact": { "type": "boolean" },
        "action": { "const": "read" },
        "source": { "$ref": "#/$defs/source" },
        "cursor": { "$ref": "#/$defs/readCursor" },
        "summary": { "$ref": "#/$defs/summary" },
        "errors": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/errorSummary" } },
        "statusChanges": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/statusChange" } },
        "suggestedNextActions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/suggestedNextAction" } }
      },
      "additionalProperties": false
    },
    "resetResult": {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "action", "source", "cursor", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.log-delta.v1" },
        "compact": { "type": "boolean" },
        "action": { "const": "reset" },
        "source": {
          "type": "object",
          "required": ["path"],
          "properties": { "path": { "type": "string" } },
          "additionalProperties": false
        },
        "cursor": {
          "type": "object",
          "required": ["id", "wasPresent"],
          "properties": {
            "id": { "type": "string", "pattern": "^log_[0-9a-f]{24}$" },
            "wasPresent": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "suggestedNextActions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/suggestedNextAction" } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["path", "sizeBytes", "readBytes", "maxBytes", "capped"],
      "properties": {
        "path": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "readBytes": { "type": "integer", "minimum": 0 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "capped": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "readCursor": {
      "type": "object",
      "required": ["id", "token", "previousOffset", "nextOffset", "resetReason", "recovered", "moreAvailable"],
      "properties": {
        "id": { "type": "string", "pattern": "^log_[0-9a-f]{24}$" },
        "token": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "previousOffset": { "type": "integer", "minimum": 0 },
        "nextOffset": { "type": "integer", "minimum": 0 },
        "resetReason": { "type": ["string", "null"], "enum": ["rotation", "truncation", null] },
        "recovered": { "type": "boolean" },
        "moreAvailable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["newBytes", "newLines", "errorCount", "returnedErrors", "statusChangeCount", "noChanges"],
      "properties": {
        "newBytes": { "type": "integer", "minimum": 0 },
        "newLines": { "type": "integer", "minimum": 0 },
        "errorCount": { "type": "integer", "minimum": 0 },
        "returnedErrors": { "type": "integer", "minimum": 0, "maximum": 12 },
        "statusChangeCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "noChanges": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "errorSummary": {
      "type": "object",
      "required": ["type", "message", "file", "line", "column", "confidence"],
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string", "maxLength": 180 },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "statusChange": {
      "type": "object",
      "required": ["kind", "level", "message", "line"],
      "properties": {
        "kind": { "enum": ["ready", "completed", "retrying", "restarting", "degraded", "failed", "stopped"] },
        "level": { "enum": ["success", "warning", "error", "info"] },
        "message": { "type": "string", "maxLength": 180 },
        "line": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
