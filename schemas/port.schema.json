{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/port.schema.json",
  "title": "AgentShell Port List Response",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "platform", "summary", "ports", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.port-list.v1" },
        "compact": { "type": "boolean" },
        "platform": { "type": "string" },
        "summary": {
          "type": "object",
          "required": ["filterPort", "matchedSockets", "returnedSockets", "processCount", "truncated"],
          "properties": {
            "filterPort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "matchedSockets": { "type": "integer", "minimum": 0 },
            "returnedSockets": { "type": "integer", "minimum": 0 },
            "processCount": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "suggestedNextActions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      },
      "additionalProperties": false
    },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "port": {
      "type": "object",
      "required": ["pid", "command", "protocol", "address", "port", "state", "listen"],
      "properties": {
        "pid": { "type": "integer", "minimum": 0 },
        "command": { "type": "string" },
        "protocol": { "type": "string" },
        "address": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "state": { "type": "string" },
        "listen": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": { "command": { "type": "string" }, "reason": { "type": "string" } },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["ok", "error"],
      "properties": { "ok": { "const": false }, "error": { "type": "object" } },
      "additionalProperties": false
    }
  }
}
