{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/pwd.schema.json",
  "title": "AgentShell Working Directory Response",
  "type": "object",
  "required": ["ok", "protocolVersion", "compact", "summary", "git", "project", "suggestedNextActions"],
  "properties": {
    "ok": { "const": true },
    "protocolVersion": { "const": "agentshell.pwd.v1" },
    "compact": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["cwd", "directoryName", "insideGitRepository", "atGitRoot", "atProjectRoot", "manifest"],
      "properties": {
        "cwd": { "type": "string" },
        "directoryName": { "type": "string" },
        "insideGitRepository": { "type": "boolean" },
        "atGitRoot": { "type": "boolean" },
        "atProjectRoot": { "type": "boolean" },
        "manifest": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "git": { "oneOf": [{ "$ref": "#/$defs/location" }, { "type": "null" }] },
    "project": { "oneOf": [{ "$ref": "#/$defs/project" }, { "type": "null" }] },
    "suggestedNextActions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
  },
  "additionalProperties": false,
  "$defs": {
    "location": {
      "type": "object",
      "required": ["root", "relation", "relativePath"],
      "properties": {
        "root": { "type": "string" },
        "relation": { "enum": ["root", "descendant"] },
        "relativePath": { "type": "string" }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["root", "manifest", "relation", "relativePath"],
      "properties": {
        "root": { "type": "string" },
        "manifest": { "type": "string" },
        "relation": { "enum": ["root", "descendant"] },
        "relativePath": { "type": "string" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": { "command": { "type": "string" }, "reason": { "type": "string" } },
      "additionalProperties": false
    }
  }
}
