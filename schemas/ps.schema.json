{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/ps.schema.json",
  "title": "AgentShell Process List Response",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "summary", "processes", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.ps.v1" },
        "compact": { "type": "boolean" },
        "summary": {
          "type": "object",
          "required": ["scannedProcesses", "matchedProcesses", "returnedProcesses", "truncated", "filter"],
          "properties": {
            "scannedProcesses": { "type": "integer", "minimum": 0 },
            "matchedProcesses": { "type": "integer", "minimum": 0 },
            "returnedProcesses": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "filter": { "enum": ["development", "all"] }
          },
          "additionalProperties": false
        },
        "processes": { "type": "array", "items": { "$ref": "#/$defs/process" } },
        "suggestedNextActions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      },
      "additionalProperties": false
    },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "process": {
      "type": "object",
      "required": ["pid", "parentPid", "user", "state", "elapsed", "command", "category"],
      "properties": {
        "pid": { "type": "integer", "minimum": 0 },
        "parentPid": { "type": "integer", "minimum": 0 },
        "user": { "type": "string" },
        "state": { "type": "string" },
        "elapsed": { "type": "string" },
        "command": { "type": "string" },
        "category": { "type": ["string", "null"], "enum": ["agent", "dashboard", "test", "container", "database", "runtime", "build-tool", null] }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": { "command": { "type": "string" }, "reason": { "type": "string" } },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["ok", "error"],
      "properties": { "ok": { "const": false }, "error": { "type": "object" } },
      "additionalProperties": false
    }
  }
}
