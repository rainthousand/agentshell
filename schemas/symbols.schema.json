{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/symbols.schema.json",
  "title": "AgentShell Symbols Response",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "file", "language", "summary", "symbols", "truncated", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.symbols.v1" },
        "compact": { "type": "boolean" },
        "file": { "type": "string" },
        "language": { "enum": ["javascript", "typescript", "go"] },
        "summary": {
          "type": "object",
          "required": ["totalSymbols", "returnedSymbols", "omittedSymbols", "truncated", "countsByKind", "exportedSymbols", "limits"],
          "properties": {
            "totalSymbols": { "type": "integer", "minimum": 0 },
            "returnedSymbols": { "type": "integer", "minimum": 0 },
            "omittedSymbols": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "countsByKind": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "exportedSymbols": { "type": "integer", "minimum": 0 },
            "limits": {
              "type": "object",
              "required": ["maxSymbols"],
              "properties": {
                "maxSymbols": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        },
        "truncated": {
          "type": "object",
          "required": ["value", "omittedSymbols", "reason"],
          "properties": {
            "value": { "type": "boolean" },
            "omittedSymbols": { "type": "integer", "minimum": 0 },
            "reason": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "suggestedNextActions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/suggestedNextAction" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message", "details", "suggestedNextActions"],
          "properties": {
            "code": {
              "enum": [
                "DENIED_PATH",
                "FILE_NOT_FOUND",
                "FILE_OUTSIDE_WORKSPACE",
                "INVALID_ARGUMENT",
                "NOT_A_FILE",
                "UNSUPPORTED_LANGUAGE"
              ]
            },
            "message": { "type": "string" },
            "details": { "type": "object" },
            "suggestedNextActions": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/suggestedNextAction" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "symbol": {
      "type": "object",
      "required": ["kind", "name", "line", "exported", "signature"],
      "properties": {
        "kind": {
          "enum": ["function", "class", "type", "interface", "enum", "const", "default", "func", "method", "var"]
        },
        "name": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "exported": { "type": "boolean" },
        "signature": { "type": "string" },
        "receiver": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
