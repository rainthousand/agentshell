{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/plugin-status.schema.json",
  "title": "AgentShell Plugin Status Response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocolVersion", "checkedAt", "plugin", "integrity", "activation", "paths", "summary", "checks", "suggestedNextActions"],
      "properties": {
        "ok": { "type": "boolean" },
        "protocolVersion": { "enum": ["agentshell.plugin-status.v1", "agentshell.plugin-doctor-local.v1"] },
        "checkedAt": { "type": "string" },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "authorName", "developerName"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "version": { "type": ["string", "null"] },
            "authorName": { "type": ["string", "null"] },
            "developerName": { "type": ["string", "null"] }
          }
        },
        "integrity": { "$ref": "#/$defs/integrity" },
        "activation": { "$ref": "#/$defs/activation" },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "manifest", "marketplace", "cacheRoot"],
          "properties": {
            "root": { "type": "string" },
            "manifest": { "type": "string" },
            "marketplace": { "type": "string" },
            "cacheRoot": { "type": "string" },
            "cachePath": { "type": "string" },
            "cacheManifest": { "type": "string" }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "warnings"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "ok", "severity"],
            "properties": {
              "name": { "type": "string" },
              "ok": { "type": "boolean" },
              "severity": { "enum": ["error", "warning"] },
              "suggestedNextActions": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "suggestedNextActions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocolVersion", "compact", "checkedAt", "status", "plugin", "integrity", "activation", "summary", "cachePath", "nextAction", "suggestedNextActions"],
      "properties": {
        "ok": { "type": "boolean" },
        "protocolVersion": { "enum": ["agentshell.plugin-status.v1", "agentshell.plugin-doctor-local.v1"] },
        "compact": { "const": true },
        "checkedAt": { "type": "string" },
        "status": { "enum": ["ready", "warning", "blocked"] },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "authorName", "developerName"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "version": { "type": ["string", "null"] },
            "authorName": { "type": ["string", "null"] },
            "developerName": { "type": ["string", "null"] }
          }
        },
        "integrity": { "$ref": "#/$defs/integrity" },
        "activation": { "$ref": "#/$defs/activation" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "warnings"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 }
          }
        },
        "cachePath": { "type": ["string", "null"] },
        "nextAction": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "reason", "text"],
              "properties": {
                "command": { "type": ["string", "null"] },
                "reason": { "type": "string" },
                "text": { "type": "string" }
              }
            },
            { "type": "null" }
          ]
        },
        "suggestedNextActions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    { "$ref": "common.schema.json#/$defs/failure" }
  ],
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "algorithm", "hash", "fileCount", "totalBytes", "missingPaths", "includePaths", "excludedNames"],
      "properties": {
        "protocolVersion": { "const": "agentshell.plugin-content-hash.v1" },
        "algorithm": { "const": "sha256" },
        "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "fileCount": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "missingPaths": { "type": "array", "items": { "type": "string" } },
        "includePaths": { "type": "array", "items": { "type": "string" } },
        "excludedNames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "comparable", "matches", "source", "installed"],
      "properties": {
        "protocolVersion": { "const": "agentshell.plugin-content-hash.v1" },
        "comparable": { "type": "boolean" },
        "matches": { "type": "boolean" },
        "source": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "installed": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "reason": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "missingPaths", "skill", "command"],
      "properties": {
        "ok": { "type": "boolean" },
        "missingPaths": { "type": "array", "items": { "type": "string" } },
        "skill": { "oneOf": [{ "$ref": "#/$defs/skillSmoke" }, { "type": "null" }] },
        "command": { "oneOf": [{ "$ref": "#/$defs/commandSmoke" }, { "type": "null" }] }
      }
    },
    "skillSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "guidance", "missing"],
      "properties": {
        "ok": { "type": "boolean" },
        "path": { "type": "string" },
        "guidance": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "error": { "type": "string" }
      }
    },
    "commandSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocolVersion"],
      "properties": {
        "ok": { "type": "boolean" },
        "protocolVersion": { "type": ["string", "null"] },
        "exitCode": { "type": ["integer", "null"] },
        "error": { "type": "string" }
      }
    }
  }
}
