{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/read.schema.json",
  "title": "AgentShell Read Response",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "protocolVersion", "file", "hash", "hashScope", "hashBytes", "hashWindow", "range", "lineNumbering", "matchedLine", "totalLines", "content", "mode", "byteSize", "workBytes", "bounded", "truncated"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.read.v1" },
        "file": { "type": "string" },
        "hash": { "type": "string", "pattern": "^sha256:" },
        "hashScope": {
          "description": "Only full hashes may be used as a whole-file expectedHash for edits.",
          "enum": ["full", "window"]
        },
        "hashBytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "hashWindow": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "range": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "integer", "minimum": 1 },
                "end": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          ]
        },
        "lineNumbering": {
          "type": "object",
          "required": ["scope", "reason"],
          "properties": {
            "scope": { "enum": ["absolute", "unknown"] },
            "reason": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "matchedLine": { "type": ["integer", "null"] },
        "totalLines": { "type": ["integer", "null"], "minimum": 0 },
        "content": { "type": "string" },
        "mode": { "enum": ["lines", "around", "head", "tail"] },
        "byteSize": { "type": "integer", "minimum": 0 },
        "workBytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "bounded": { "type": "boolean" },
        "truncated": {
          "type": "object",
          "required": ["value", "reason"],
          "properties": {
            "value": { "type": "boolean" },
            "reason": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    { "$ref": "common.schema.json#/$defs/failure" }
  ]
}
