{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/imports.schema.json",
  "title": "AgentShell Imports Response",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "file", "language", "summary", "imports", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.imports.v1" },
        "compact": { "type": "boolean" },
        "file": { "type": "string" },
        "language": { "enum": ["javascript", "typescript", "go"] },
        "summary": { "$ref": "#/$defs/summary" },
        "imports": {
          "type": "array",
          "items": { "$ref": "#/$defs/importEntry" },
          "maxItems": 100
        },
        "suggestedNextActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "summary": {
      "type": "object",
      "required": ["importCount", "returnedImports", "omittedImports", "truncated", "sourceCount", "specifierCount", "builtinCount", "externalCount", "relativeCount", "byKind"],
      "properties": {
        "importCount": { "type": "integer", "minimum": 0 },
        "returnedImports": { "type": "integer", "minimum": 0 },
        "omittedImports": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "sourceCount": { "type": "integer", "minimum": 0 },
        "specifierCount": { "type": "integer", "minimum": 0 },
        "builtinCount": { "type": "integer", "minimum": 0 },
        "externalCount": { "type": "integer", "minimum": 0 },
        "relativeCount": { "type": "integer", "minimum": 0 },
        "byKind": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "importEntry": {
      "type": "object",
      "required": ["source", "type", "specifiers", "count", "builtin", "external", "relative"],
      "properties": {
        "source": { "type": "string" },
        "type": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["runtime", "type", "side-effect", "dynamic", "go"] }
          },
          "additionalProperties": false
        },
        "specifiers": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 40
        },
        "count": { "type": "integer", "minimum": 0 },
        "builtin": { "type": "boolean" },
        "external": { "type": "boolean" },
        "relative": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": {
        "command": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "details", "suggestedNextActions"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object" },
        "suggestedNextActions": { "type": "array" }
      },
      "additionalProperties": false
    }
  }
}
