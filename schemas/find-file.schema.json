{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/find-file.schema.json",
  "title": "AgentShell Find File Response",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "protocolVersion", "compact", "summary", "files", "suggestedNextActions"],
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "const": "agentshell.find-file.v1" },
        "compact": { "type": "boolean" },
        "summary": {
          "type": "object",
          "required": ["pattern", "searchPath", "totalMatches", "returnedMatches", "truncated", "ignoredDirectories", "unreadableDirectories", "scannedEntries", "scanLimit", "scanTruncated", "categories", "risks"],
          "properties": {
            "pattern": { "type": "string" },
            "searchPath": { "type": "string" },
            "totalMatches": { "type": "integer", "minimum": 0 },
            "returnedMatches": { "type": "integer", "minimum": 0, "maximum": 500 },
            "truncated": { "type": "boolean" },
            "ignoredDirectories": { "type": "integer", "minimum": 0 },
            "unreadableDirectories": { "type": "integer", "minimum": 0 },
            "scannedEntries": { "type": "integer", "minimum": 0, "maximum": 250000 },
            "scanLimit": { "type": "integer", "minimum": 1, "maximum": 250000 },
            "scanTruncated": { "type": "boolean" },
            "categories": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "risks": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
          },
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/file" }
        },
        "suggestedNextActions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      },
      "additionalProperties": false
    },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "name", "category", "sizeBytes", "risk", "readCommand"],
      "properties": {
        "path": { "type": "string" },
        "name": { "type": "string" },
        "category": { "enum": ["source", "test", "config", "docs", "generated", "asset", "other"] },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "risk": { "enum": ["low", "medium", "high"] },
        "readCommand": { "type": "string" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": { "command": { "type": "string" }, "reason": { "type": "string" } },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["ok", "error"],
      "properties": { "ok": { "const": false }, "error": { "type": "object" } },
      "additionalProperties": false
    }
  }
}
