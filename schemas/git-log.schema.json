{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/git-log.schema.json",
  "title": "AgentShell Git Log Response",
  "type": "object",
  "required": ["ok", "protocolVersion", "compact", "summary", "commits", "suggestedNextActions"],
  "properties": {
    "ok": { "const": true },
    "protocolVersion": { "const": "agentshell.git-log.v1" },
    "compact": { "type": "boolean" },
    "summary": { "$ref": "#/$defs/summary" },
    "commits": {
      "type": "array",
      "items": { "$ref": "#/$defs/commit" },
      "maxItems": 50
    },
    "suggestedNextActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/suggestedNextAction" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": ["requestedLimit", "returnedCommits", "hasCommits", "truncated"],
      "properties": {
        "requestedLimit": { "type": "integer", "minimum": 1, "maximum": 50 },
        "returnedCommits": { "type": "integer", "minimum": 0, "maximum": 50 },
        "hasCommits": { "type": "boolean" },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "required": ["hash", "shortHash", "subject", "authorName", "authorDate", "relativeAge"],
      "properties": {
        "hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "shortHash": { "type": "string", "pattern": "^[0-9a-f]{7,12}$" },
        "subject": { "type": "string" },
        "authorName": { "type": "string" },
        "authorDate": { "type": ["string", "null"] },
        "relativeAge": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "suggestedNextAction": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": {
        "command": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
