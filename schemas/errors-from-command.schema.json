{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.local/schemas/errors-from-command.schema.json",
  "title": "AgentShell Errors From Command Response",
  "type": "object",
  "required": ["ok", "protocolVersion", "compact", "command", "exitCode", "signal", "durationMs", "timedOut", "truncated", "logRef", "summary", "errors", "suggestedNextActions"],
  "properties": {
    "ok": { "type": "boolean" },
    "protocolVersion": { "const": "agentshell.errors-from-command.v1" },
    "compact": { "type": "boolean" },
    "command": { "type": "string" },
    "exitCode": { "type": "integer" },
    "signal": { "type": ["string", "null"] },
    "durationMs": { "type": "number", "minimum": 0 },
    "timedOut": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "logRef": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["mainError", "errorCount", "returnedErrors"],
      "properties": {
        "mainError": { "type": ["string", "null"] },
        "errorCount": { "type": "integer", "minimum": 0 },
        "returnedErrors": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "errors": { "type": "array" },
    "suggestedNextActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": {
        "command": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
